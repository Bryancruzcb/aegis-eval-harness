# AegisEval Environment Configuration
# Copy this file to .env and fill in your API keys.

# API Keys (Provide at least one)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Target model config (the model being evaluated)
# Supported providers: gemini, openai, ollama
TARGET_PROVIDER=gemini
TARGET_MODEL=gemini-1.5-flash

# Judge model config (the model evaluating the outputs)
# Supported providers: gemini, openai, ollama
# Note: For production, a stronger model like gemini-1.5-pro or gpt-4o is recommended for best grading reliability.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-1.5-flash

# Concurrency & Rates
MAX_CONCURRENT_REQUESTS=5
