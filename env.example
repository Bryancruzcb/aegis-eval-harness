# AegisEval environment configuration.
# Copy this file to .env and fill in the key(s) for the provider(s) you use.
# (.env is git-ignored — your keys never get committed.)

# --- API keys (provide the one(s) you need; Ollama needs none) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Target model: the model being evaluated ---
# Providers: gemini | openai | ollama
# Note: older flash models (1.5/2.0, and 2.5-flash for new API keys) 404 as
# "no longer available to new users". gemini-3.5-flash is current.
TARGET_PROVIDER=gemini
TARGET_MODEL=gemini-3.5-flash

# --- Judge model: the model grading the target's answers ---
# A stronger judge grades more reliably.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash

# --- Run tuning ---
# Concurrency kept low so free-tier rate limits don't trigger 429 storms.
MAX_CONCURRENT_REQUESTS=3
# Attempts per API call before giving up (retries transient 429/5xx/timeout).
MAX_RETRIES=4

# Local Ollama endpoint (only used when a provider is set to "ollama").
OLLAMA_BASE_URL=http://localhost:11434/v1
